[alias]
	delete-squashed = "!f() { local targetBranch=${1:-main} && git checkout -q $targetBranch && git branch --merged | grep -v \"\\*\" | xargs -n 1 git branch -d && git for-each-ref refs/heads/ \"--format=%(refname:short)\" | while read branch; do mergeBase=$(git merge-base $targetBranch $branch) && [[ $(git cherry $targetBranch $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) == \"-\"* ]] && git branch -D $branch; done; }; f"

[branch]
sort = -committerdate

[commit]
gpgsign = true

[core]
excludesFile = ~/.config/git/ignore
	ignorecase = false

[diff]
	algorithm = histogram
	colorMoved = default

# Difftastic
# From https://difftastic.wilfred.me.uk/git.html#regular-usage
[diff]
	tool = difftastic ## setup `git difftool` to run difftastic

[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"

[difftool]
       prompt = false

# Delta
# From https://github.com/dandavison/delta#get-started
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections

